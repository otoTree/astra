{
  "name": "astra",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*",
    "model-workers/*"
  ],
  "scripts": {
    "dev:public-api": "bun run apps/api/src/public.ts",
    "dev:admin-api": "bun run apps/api/src/admin.ts",
    "dev:worker-control-api": "bun run apps/api/src/worker-control.ts",
    "dev:model-app": "bun run model-workers/reference/src/server.ts",
    "dev:admin-web": "bun run --cwd apps/admin-web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:unit": "bun test --timeout 10000",
    "test:integration:postgres": "ASTRA_TEST_DATABASE_URL=${ASTRA_TEST_DATABASE_URL:-postgres://astra:astra@127.0.0.1:55432/astra} bun test packages/database/src/task-service.integration.test.ts --timeout 30000",
    "test:integration:s3": "ASTRA_TEST_DATABASE_URL=${ASTRA_TEST_DATABASE_URL:-postgres://astra:astra@127.0.0.1:55432/astra} ASTRA_TEST_S3_ENDPOINT=${ASTRA_TEST_S3_ENDPOINT:-http://127.0.0.1:59000} ASTRA_TEST_S3_PUBLIC_ENDPOINT=${ASTRA_TEST_S3_PUBLIC_ENDPOINT:-http://127.0.0.1:59000} ASTRA_TEST_S3_BUCKET=${ASTRA_TEST_S3_BUCKET:-astra-local} ASTRA_TEST_S3_ACCESS_KEY=${ASTRA_TEST_S3_ACCESS_KEY:-astra} ASTRA_TEST_S3_SECRET_KEY=${ASTRA_TEST_S3_SECRET_KEY:-astra-local-secret} bun test apps/api/src/file-service.integration.test.ts --timeout 30000",
    "test:integration:local": "bun run test:integration:postgres && bun run test:integration:s3",
    "db:migrate": "bun run packages/database/src/migrate.ts",
    "db:migrate:check": "bun run scripts/check-migrations.ts",
    "contracts:check": "bun run scripts/check-contracts.ts",
    "dependencies:check": "bun run scripts/check-dependencies.ts",
    "compose:check": "docker compose -p astra-local -f deploy/compose/docker-compose.yml config --quiet",
    "build": "bun run scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run dependencies:check && bun run typecheck && bun run contracts:check && bun run db:migrate:check && bun run test:unit && bun run build",
    "compose:up": "docker compose -p astra-local -f deploy/compose/docker-compose.yml up -d",
    "compose:down": "docker compose -p astra-local -f deploy/compose/docker-compose.yml down"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.2",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "@types/node": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "bun-types": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "yaml": "2.9.0"
  }
}
